# --- Choose a provider: gemini | anthropic | openai -------------------------
PROVIDER=gemini

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # Groq, OpenRouter, local Ollama (http://localhost:11434/v1), ...

# --- Optional ----------------------------------------------------------------
# MODEL=                      # defaults per provider
# SYSTEM_PROMPT=You are a friendly, concise assistant.
# MAX_TOKENS=2048
# MAX_RETRIES=3
# MAX_HISTORY_MESSAGES=40
# RATE_LIMIT_PER_MINUTE=30    # 0 disables
# LOG_LEVEL=INFO
